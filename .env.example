# Copy to .env and fill in. Leave keys empty to run in mock mode.

# "live" calls real providers; "mock" uses simulated providers (no keys needed)
NEXUS_PROVIDER_MODE=mock

# Gemini (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_REASONING_EFFORT=          # optional: low | medium | high

# Optional extra providers; the router uses every provider with a key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth (empty = disabled; set both in any shared deployment)
NEXUS_API_KEY=
NEXUS_ADMIN_API_KEY=

# Storage (docker-compose sets these; empty = in-memory)
# DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
# REDIS_URL=redis://localhost:6379/0

# Embeddings: "gemini", "openai" or "hash" (default: first available in that order in live mode)
# NEXUS_EMBEDDINGS=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# NEXUS_EMBEDDING_DIM=

# Caching
# NEXUS_EXACT_CACHE_TTL_S=3600
# NEXUS_SEMANTIC_CACHE=true
# NEXUS_SEMANTIC_THRESHOLD=          # default 0.95 (Gemini/OpenAI) / 0.97 (hash); calibrate with scripts/smoke_live.py
# NEXUS_SEMANTIC_MAX_CHARS=2000
# NEXUS_SEMANTIC_CACHE_TTL_S=86400
# NEXUS_CACHE_MAX_TEMPERATURE=0.3

# Resilience
# NEXUS_MAX_RETRIES=2
# NEXUS_RETRY_BASE_DELAY_S=0.25
# NEXUS_BREAKER_THRESHOLD=5
# NEXUS_BREAKER_RESET_S=30
# NEXUS_REQUEST_TIMEOUT_S=30

# RAG
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=5
# RAG_MIN_SCORE=                     # default 0.5 (Gemini) / 0.25 (OpenAI) / 0.15 (hash); calibrate with smoke_live.py

# Load a folder of documents into RAG at startup (handy with the in-memory store)
# NEXUS_INGEST_ON_START=data/sample_docs

# Server (Docker image): port and gunicorn workers; keep 1 worker without PostgreSQL+Redis
# PORT=8000
# NEXUS_WORKERS=1

# Cost reporting baseline (default: gemini-3.8-flash if Gemini is the only provider, else claude-sonnet-4-5)
# NEXUS_BASELINE_MODEL=

# Mock mode: which providers to simulate
# MOCK_PROVIDERS=openai,anthropic

# OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# NEXUS_OTEL_CONSOLE=1
